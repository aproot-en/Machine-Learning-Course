    "ax.scatter(x, y, color='dimgray', s=20, zorder=3, label='Observed Data')\n",
    "\n",
    "# Regression line\n",
    "xs = np.sort(x)\n",
    "ax.plot(xs, b0 + b1 * xs, color='tab:blue', lw=2.5, label='Regression Line')\n",
    "\n",
    "# Highlight the largest residual\n",
    "i = np.argmax(np.abs(y - y_hat))\n",
    "\n",
    "ax.scatter(x[i], y[i], color='red', s=90, zorder=4, label='Actual Value')\n",
    "ax.scatter(x[i], y_hat[i], color='tab:blue', s=90, zorder=4, label='Predicted Value')\n",
    "\n",
    "# Residual\n",
    "ax.plot([x[i], x[i]], [y[i], y_hat[i]], 'r--', lw=2)\n",
    "ax.annotate(\n",

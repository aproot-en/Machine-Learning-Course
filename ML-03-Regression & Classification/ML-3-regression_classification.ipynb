    "# ============================================================\n",
    "# 0.4 สุ่มตัวอย่าง 6,000 ภาพ และดูใบหน้าเฉลี่ย\n",
    "# ============================================================\n",
    "\n",
    "# Sample a subset to reduce memory usage\n",
    "sub = df.sample(6000, random_state=SEED).reset_index(drop=True)\n",
    "X_sub = np.stack(sub['pixels'].apply(decode_pixels)).reshape(len(sub), -1)  # (6000, 2304)\n",
    "\n",
    "fig, axes = plt.subplots(1, 5, figsize=(15, 3.5))\n",
    "\n",
    "# Average face by gender\n",
    "for i, g in enumerate([0, 1]):\n",
    "    avg_face = X_sub[(sub['gender'] == g).values].mean(axis=0).reshape(IMG, IMG)\n",
    "    axes[i].imshow(avg_face, cmap='gray')\n",
    "    axes[i].set_title(gender_label[g])\n",
    "    axes[i].axis(\"off\")\n",
    "\n",
    "# Average face by age group\n",
    "age_groups = [(0, 12), (25, 40), (60, 116)]\n",
    "\n",
    "for i, (low, high) in enumerate(age_groups, start=2):\n",
    "    mask = ((sub['age'] >= low) & (sub['age'] <= high)).values\n",
    "    avg_face = X_sub[mask].mean(axis=0).reshape(IMG, IMG)\n",
    "    axes[i].imshow(avg_face, cmap='gray')\n",
    "    axes[i].set_title(f\"Age {low}-{high}\")\n",
    "    axes[i].axis(\"off\")\n",
    "\n",
    "plt.suptitle(\"Average Face Images\"); plt.tight_layout(); plt.show()"
   ]

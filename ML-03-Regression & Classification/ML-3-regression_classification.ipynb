    "# ============================================================\n",
    "# 3.4 Model Performance Metrics: Manual vs scikit-learn\n",
    "# ============================================================\n",
    "from sklearn.metrics import mean_squared_error\n",
    "\n",
    "# --- (a) Regression metrics: age model (test set)\n",
    "resid = ate - age_pred\n",
    "\n",
    "mae_m = np.mean(np.abs(resid))\n",
    "mse_m = np.mean(resid ** 2)\n",
    "rmse_m = np.sqrt(mse_m)\n",
    "r2_m = 1 - np.sum(resid ** 2) / np.sum((ate - ate.mean()) ** 2)\n",
    "\n",
    "reg_results = pd.DataFrame({\n",
    "    \"Manual\": [mae_m, mse_m, rmse_m, r2_m],\n",
    "    \"scikit-learn\": [\n",
    "        mean_absolute_error(ate, age_pred),\n",
    "        mean_squared_error(ate, age_pred),\n",
    "        np.sqrt(mean_squared_error(ate, age_pred)),\n",
    "        r2_score(ate, age_pred)\n",
    "    ]\n",
    "}, index=[\"MAE (years)\", \"MSE\", \"RMSE (years)\", \"R²\"])\n",
    "\n",
    "print(\"--- Regression Metrics (Age Model) ---\")\n",
    "print(reg_results.round(4))\n",
    "print(f\"\\nตีความ: โมเดลทำนายอายุพลาดเฉลี่ย {mae_m:.1f} ปี \"\n",
    "      f\"และอธิบายความแปรปรวนของอายุได้ {r2_m * 100:.1f}%\")\n",
    "\n",
    "# --- (b) Classification metrics: gender model (test set)\n",

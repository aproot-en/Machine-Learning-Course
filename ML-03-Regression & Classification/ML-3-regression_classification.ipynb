    "print(f\"F1-score  = {f1_score(g_te, g_pred):.4f}\")\n",
    "\n",
    "print(\"\\n--- Classification Report ---\")\n",
    "print(classification_report(\n",
    "    g_te, g_pred, target_names=[\"Male\", \"Female\"]\n",
    "))"

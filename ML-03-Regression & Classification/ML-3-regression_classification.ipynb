   "source": [
    "# ============================================================\n",
    "# 1.1 Simple Linear Regression: Manual OLS vs scikit-learn\n",
    "# ============================================================\n",
    "\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import r2_score\n",
    "\n",
    "# Use all 6,000 samples: X = one PCA feature, y = age\n",
    "x_all = Z_sub[:, BEST_PC_AGE]\n",
    "y_all = age_sub\n",
    "\n",
    "# (a) Calculate OLS manually\n",
    "x_mean = x_all.mean()\n",
    "y_mean = y_all.mean()\n",
    "\n",
    "beta1 = np.sum((x_all - x_mean) * (y_all - y_mean)) / np.sum((x_all - x_mean) ** 2)\n",
    "beta0 = y_mean - beta1 * x_mean\n",
    "\n",
    "print(\"--- Manual OLS Calculation ---\")\n",
    "print(f\"beta0 (Intercept) = {beta0:.4f}\")\n",
    "print(f\"beta1 (Slope)     = {beta1:.4f}\")\n",
    "\n",
    "# (b) Compare with scikit-learn\n",
    "X_simple = x_all.reshape(-1, 1)\n",
    "simple_lr = LinearRegression()\n",
    "simple_lr.fit(X_simple, y_all)\n",
    "\n",
    "print(\"\\n--- scikit-learn ---\")\n",
    "print(f\"beta0 = {simple_lr.intercept_:.4f}\")\n",
    "print(f\"beta1 = {simple_lr.coef_[0]:.4f}\")\n",
    "\n",
    "# (c) Evaluate the model\n",
    "y_pred = simple_lr.predict(X_simple)\n",
    "r2_simple = r2_score(y_all, y_pred)\n",
    "\n",
    "print(f\"\\nR² of Simple Regression = {r2_simple:.3f}\")\n",
    "print(f\"One feature explains approximately {r2_simple * 100:.0f}% of the age variation.\")\n",
    "print(\"This shows that one PCA feature is not enough to represent complex facial patterns.\")\n",
    "print(\"Therefore, multiple features will be used in the next section.\")"
   ]
  },

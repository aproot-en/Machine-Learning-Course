    "# ============================================================\n",
    "# 2.3 Sigmoid Function and Probability Prediction\n",
    "# ============================================================\n",
    "\n",
    "def sigmoid(x):\n",
    "    return 1 / (1 + np.exp(-x))\n",
    "\n",
    "x = np.linspace(-7, 7, 200)\n",
    "\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.plot(x, sigmoid(x), linewidth=2)\n",
    "plt.axhline(0.5, color=\"red\", linestyle=\"--\", label=\"Threshold = 0.5\")\n",
    "plt.axvline(0, color=\"gray\", linestyle=\":\")\n",
    "plt.text(-6, 0.15, \"Male\")\n",
    "plt.text(4, 0.82, \"Female\")\n",
    "plt.xlabel(\"z\")\n",
    "plt.ylabel(\"Probability\")\n",
    "plt.title(\"Sigmoid Function\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "print(f\"sigmoid(2.0)  = {sigmoid(2.0):.3f} -> Female\")\n",
    "print(f\"sigmoid(-1.5) = {sigmoid(-1.5):.3f} -> Male\")\n",
    "\n",
    "# Predict the new sample with probabilities\n",
    "prob = clf2.predict_proba(new_point)[0]\n",
    "pred = clf2.predict(new_point)[0]\n",
    "\n",
    "print(f\"\\n--- New Sample ---\")\n",
    "print(f\"P(Male) = {prob[0]:.3f} | P(Female) = {prob[1]:.3f}\")\n",
    "print(f\"Predicted: {gender_label[pred]} | Actual: {gender_label[g_te[new_idx]]}\")"
   ]

    "# ============================================================\n",
    "# 0.2 แปลงพิกเซลเป็นภาพ และดูตัวอย่างภาพ\n",
    "# ============================================================\n",
    "IMG = 48   # Image size: 48x48 Pixels (48*48 = 2304 pixels)\n",
    "\n",
    "def decode_pixels(pixel_str):\n",
    "    return np.asarray(pixel_str.split(), dtype=np.float32).reshape(IMG, IMG) / 255.0\n",
    "\n",
    "# Display information for the first image\n",
    "img = decode_pixels(df.loc[0, 'pixels'])\n",
    "print(\"Image size:\", img.shape)\n",
    "print(\"Pixel range:\", img.min(), \"to\", img.max())\n",
    "\n",
    "# Show 10 random images\n",
    "gender_label = {0: \"Male\", 1: \"Female\"}\n",
    "\n",
    "fig, axes = plt.subplots(2, 5, figsize=(12, 5))\n",
    "\n",
    "for ax, (_, row) in zip(axes.ravel(), df.sample(10, random_state=SEED).iterrows()):\n",
    "    ax.imshow(decode_pixels(row['pixels']), cmap='gray')\n",
    "    ax.set_title(f\"Age: {row['age']} | {gender_label[row['gender']]}\", fontsize=9)\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "plt.suptitle(\"Sample Face Images\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },

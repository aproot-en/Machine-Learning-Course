    "# ============================================================\n",
    "# 2.2 Train a Classifier and Visualize Its Decision Boundary\n",
    "# ============================================================\n",
    "\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "clf2 = LogisticRegression().fit(Z2_tr, g_tr)\n",
    "\n",
    "def plot_boundary(model, X, y):\n",
    "    x1 = np.linspace(X[:, 0].min() - 2, X[:, 0].max() + 2, 200)\n",
    "    x2 = np.linspace(X[:, 1].min() - 2, X[:, 1].max() + 2, 200)\n",
    "    xx, yy = np.meshgrid(x1, x2)\n",
    "\n",
    "    pred = model.predict(np.c_[xx.ravel(), yy.ravel()])\n",
    "    pred = pred.reshape(xx.shape)\n",
    "\n",
    "    plt.contourf(xx, yy, pred, alpha=0.25, cmap=\"coolwarm\")\n",
    "    plt.scatter(*X[y == 0].T, s=10, alpha=0.5, label=\"Male\")\n",
    "    plt.scatter(*X[y == 1].T, s=10, alpha=0.5, marker=\"x\", label=\"Female\")\n",
    "\n",
    "# Plot decision boundary with the new sample\n",
    "new_point = Z2_te[[new_idx]]\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plot_boundary(clf2, Z2_tr, g_tr)\n",
    "\n",
    "plt.scatter(\n",
    "    *new_point.T,\n",
    "    marker=\"*\", s=300, color=\"green\", edgecolor=\"black\",\n",
    "    label=\"New Sample\"\n",
    ")\n",
    "\n",
    "plt.xlabel(f\"PC{PC_A + 1}\")\n",
    "plt.ylabel(f\"PC{PC_B + 1}\")\n",
    "plt.title(\"Decision Boundary Learned by the Model\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]

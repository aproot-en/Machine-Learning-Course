    "# ============================================================\n",
    "# 2.1 Prepare Classification Data\n",
    "# ============================================================\n",
    "\n",
    "# Adult samples only\n",
    "adult = age_sub >= 18\n",
    "Z_ad = Z_sub[adult]\n",
    "g_ad = gender_sub[adult]\n",
    "X_ad = X_sub[adult]\n",
    "\n",
    "print(f\"Adult samples: {len(g_ad)} \"\n",
    "      f\"(Male: {(g_ad == 0).sum()}, Female: {(g_ad == 1).sum()})\")\n",
    "\n",
    "# Select the two PCs most correlated with gender\n",
    "corr = [abs(np.corrcoef(Z_ad[:, i], g_ad)[0, 1]) for i in range(N_PC)]\n",
    "PC_A, PC_B = np.argsort(corr)[-2:][::-1]\n",
    "\n",
    "print(f\"Best 2 features for gender: PC{PC_A + 1}, PC{PC_B + 1}\")\n",
    "\n",
    "# Stratified Train / Test split (shared indices for 2-PC and 50-PC versions)\n",
    "idx_tr, idx_te = train_test_split(\n",
    "    np.arange(len(g_ad)),\n",
    "    test_size=0.25,\n",
    "    random_state=SEED,\n",
    "    stratify=g_ad\n",
    ")\n",
    "\n",
    "Z2_tr, Z2_te = Z_ad[idx_tr][:, [PC_A, PC_B]], Z_ad[idx_te][:, [PC_A, PC_B]]\n",
    "Z50_tr, Z50_te = Z_ad[idx_tr], Z_ad[idx_te]\n",
    "g_tr, g_te = g_ad[idx_tr], g_ad[idx_te]\n",
    "X_te = X_ad[idx_te]\n",
    "\n",
    "print(f\"Training: {len(g_tr)}  Testing: {len(g_te)}\")\n",
    "\n",
    "# One test sample to use as \"New Sample\"\n",
    "new_idx = 3\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "# Feature space\n",
    "ax[0].scatter(*Z2_tr[g_tr == 0].T, s=12, alpha=0.5, label=\"Male\")\n",
    "ax[0].scatter(*Z2_tr[g_tr == 1].T, s=12, alpha=0.5, marker=\"x\", label=\"Female\")\n",
    "ax[0].scatter(*Z2_te[new_idx].T, s=300, marker=\"*\", color=\"green\",\n",
    "              edgecolor=\"black\", label=\"New Sample\")\n",
    "\n",
    "ax[0].set_xlabel(f\"PC{PC_A + 1}\")\n",
    "ax[0].set_ylabel(f\"PC{PC_B + 1}\")\n",
    "ax[0].set_title(\"2D Feature Space\")\n",
    "ax[0].legend()\n",
    "\n",
    "# Face image of the new sample\n",
    "ax[1].imshow(X_te[new_idx].reshape(IMG, IMG), cmap=\"gray\")\n",
    "ax[1].set_title(f\"New Sample (Actual: {gender_label[g_te[new_idx]]})\")\n",
    "ax[1].axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
